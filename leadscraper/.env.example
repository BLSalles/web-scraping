# Opcional. Com a chave, o Google Maps usa a Places API oficial (mais estável).
# Sem ela, cai no scraping via navegador (Playwright).
GOOGLE_PLACES_API_KEY=

# Pasta onde ficam os zips da Receita (Estabelecimentos*.zip, Empresas*.zip, Cnaes.zip, Municipios.zip)
CNPJ_DIR=data/cnpj

DB_PATH=data/leads.db
REQUEST_DELAY=1.5
USER_AGENT=Mozilla/5.0 (compatible; LeadScraper/1.0)
