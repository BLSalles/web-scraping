# Motor do Google Maps (google-maps-scraper-kit). O app sobe o motor sozinho a partir de KIT_DIR.
# Padrão: pasta google-maps-scraper-kit dentro deste projeto.
# KIT_DIR=google-maps-scraper-kit
KIT_URL=http://localhost:8080

# Pasta onde ficam os zips da Receita (Estabelecimentos*.zip, Empresas*.zip, Cnaes.zip, Municipios.zip)
CNPJ_DIR=data/cnpj

DB_PATH=data/leads.db
REQUEST_DELAY=1.5
USER_AGENT=Mozilla/5.0 (compatible; LeadScraper/1.0)

# 1 = desliga o Google Maps (use em servidor com pouca memória, como o plano gratuito do Render)
SEM_NAVEGADOR=0
